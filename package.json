{
  "name": "rag",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prod": "npx sequelize-cli db:migrate && (node dist/worker/worker.js & npm run start)",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "dev:docker": "ts-node-dev --respawn --transpile-only --poll --ignore-watch node_modules --watch src src/server.ts",
    "start": "node dist/server.js",
    "db:create:test": "cross-env NODE_ENV=test npx dotenv-cli -e .env.test -- sequelize-cli db:create --env test",
    "db:migrate:test": "cross-env NODE_ENV=test npx dotenv-cli -e .env.test -- sequelize-cli db:migrate --env test",
    "prestart": "npm run build",
    "pretest": "cross-env NODE_ENV=test DB_HOST=127.0.0.1 DB_PORT=3307 DB_DIALECT=mysql npm run db:create:test && npm run db:migrate:test",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "jest -c ./jest.config.cjs --watch",
    "test:coverage": "jest -c ./jest.config.cjs --coverage",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/worker.ts",
    "worker:doc": "ts-node src/worker/worker.ts --doc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.15.1",
    "openai": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "3.10.111",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
