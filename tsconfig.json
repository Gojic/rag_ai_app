{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "esModuleInterop": true,
    "rootDir": "src",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "types": ["node", "jest"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
